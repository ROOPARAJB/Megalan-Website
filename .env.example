# Server Configuration
PORT=3000
NODE_ENV=production
APP_NAME=VPSA_YOGA_FRISH

# Security Secrets (Must be changed in production)
JWT_SECRET=your_super_secret_cryptographic_key_here_minimum_64_characters
SESSION_COOKIE_NAME=vpsa_session_token

# Admin Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_EMAIL=contact@vpsayogafresh.com

# Upload Configuration
MAX_FILE_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=10

# Supabase Cloud Database Configuration
# Find these in your Supabase Project Settings -> API (URL and service_role/anon key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

